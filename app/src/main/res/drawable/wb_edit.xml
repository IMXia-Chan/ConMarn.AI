<?xml version="1.0" encoding="utf-8"?>
<!-- 超级工作台：输入框。
     ★ 不用系统那套下划线 —— 它在黑底上是一条灰线，像一个没填完的表单。
     这里用的是「一块凹进去的玻璃」：底色比周围更深一格，描边只给一点点绿。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#99060C0F" />
    <corners android:radius="4dp" />
    <stroke
        android:width="1dp"
        android:color="#3335FFB0" />
</shape>
