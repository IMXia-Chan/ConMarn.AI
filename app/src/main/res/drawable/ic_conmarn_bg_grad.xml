<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标的底色层：深靛蓝到近黑的斜向渐变。
  前景是透明底的「C」,底色单独放这一层,启动器做视差/缩放时不会把底纹拉变形。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="#1B1B3C"
        android:endColor="#07070E" />
</shape>
