<?xml version="1.0" encoding="utf-8"?>
<!--
  她房间里的次要按钮(声音 / 唤醒 / 主动 三个开关)。

  为什么要自己画一个:不指定 background 的 Button 会吃主题里的 accent —— 那是
  触控板主界面留下的绿色 #4CAF50,在一个深色聊天界面里顶着一排荧光绿,像是
  从别的 App 借来的。这里用她的粉描边。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="8dp" />
    <solid android:color="#1E2126" />
    <stroke android:width="1dp" android:color="#66E05B8E" />
</shape>
