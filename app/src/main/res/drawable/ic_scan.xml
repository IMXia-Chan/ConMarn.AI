<!-- 扫描(放大镜):找到局域网里那台电脑。
     ★ 2026-10-04 晚新增 —— 「扫描」从抽屉搬进书签条的一级页(终端)之后需要自己的图标。
     画法和 `ic_swap` / `ic_mic` 一样是纯 path + `android:tint` 上色,所以 fillColor 用白、
     真正的颜色在布局里给。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- 镜圈 -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.9"
        android:pathData="M10.4,10.4 m-5.6,0 a5.6,5.6 0 1,0 11.2,0 a5.6,5.6 0 1,0 -11.2,0" />
    <!-- 镜柄 -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.9"
        android:strokeLineCap="round"
        android:pathData="M14.6,14.6 L19.8,19.8" />
</vector>
