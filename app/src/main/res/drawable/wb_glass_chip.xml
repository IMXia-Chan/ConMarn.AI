<!--
  超级工作台：底栏那些切换片 —— **透明磨砂玻璃**的小胶囊。

  ★ 2026-11-06 他要「全部改成透明磨砂玻璃」，并明确一件事：
    **点一下展开、选一项**，不再点一下换一个。所以形状从方角片改成胶囊，
    让人一眼看出这是个**可以打开**的东西，而不是一个计数器。
    展开后的列表用同一个外壳（见 WorkbenchActivity.choose()）。

  按下时亮一档 —— 看得见「我点到了」，而不是靠一句 toast。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#33FFFFFF" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#59FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#17FFFFFF" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#38FFFFFF" />
        </shape>
    </item>
</selector>
