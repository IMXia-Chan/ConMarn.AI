<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Wi-Fi 局域网通信所需 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 16(API 36)起,访问局域网(内网 IP)必须单独申请「本地网络」权限;
         没有它,外网照通、内网全断(连 192.168.x.x 直接超时)。低版本系统会忽略此声明。 -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!-- 扫描电脑上的配对二维码(ZXing) + 手机当摄像头 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 手机麦克风当电脑麦克风 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- 保活:前台服务防进程被后台杀,切 App/息屏不断连 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- 推摄像头/麦克风时服务升级成 camera/microphone 类型(系统当「正在录像/录音」,ColorOS 不易强停) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- ★★ 2026-10-04「她一直在」新增的两条 —— **先问过用户、他点头才加的**,
         不是顺手加的(项目老规矩:加权限必须让用户知情;见 human-does-irreversible-system-ops)。

         ① RECEIVE_BOOT_COMPLETED:重启后她能自己回来。
            不做的代价是实测出来的 —— 冷装载模型要 **70 秒**(不是 12 秒,那是页缓存热着时的数),
            每次冷开机用户都得先干等这么久。见记忆 ruoxi-her-boot。

         ② FOREGROUND_SERVICE_SPECIAL_USE:让「她一直活着」有一个系统认可的形态。
            **不能用现成的 dataSync** —— Android 15+ 给它设了「每 24 小时累计 6 小时」
            的硬上限(到点抛 RemoteServiceException),而且它在开机广播的**禁用名单**上
            (同名单:camera/mediaPlayback/phoneCall/mediaProjection/microphone)。
            specialUse **不在名单上、也没有时间配额**,是唯一走得通的路。
            代价:它需要一个理由字符串(见 HerLifeService 的 <property>),我们认。
            见 HerLifeService 的类注释。

         两条都只在本机生效:不联网、不改系统设置、不动别的应用。 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 引导用户允许忽略电池优化,绕开 ColorOS 的 Stop FGS timeout 强停 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 文件互传中转站:真·系统级悬浮球(悬浮在任意 App 之上),需用户到设置里授权 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 呼出面板/书签条:弹出收起时 50/30ms 短震反馈 -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- ★ 这不是权限 —— 不给用户弹任何框,也不多给一分能力。
         Android 11(API 30)起,不声明这里的话**看不见别的应用**:
         `getLaunchIntentForPackage` 对每个包都静默返回 null。
         我们那只「打开手机上的应用」的手会表现成「手机上没装微信」——
         一个查不出原因的空菜单(同一个坑见 open_app 的六零宽空格那轮)。
         声明的是「能启动的应用」这个类别,不是一份包名白名单。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>

        <!-- ★★ 2026-10-04:她「不发声」的真根因就在这一条缺失上。
             用户原话:「她得发声啊,知道吧」。

             没有这条声明时,`TextToSpeech` 的 `getDefaultEngine()` 会走
             `getHighestRankedEngineName()` → `TtsEngines.getEngines()` →
             `pm.queryIntentServices(new Intent(TTS_SERVICE))` —— 而 targetSdk≥30 的 App
             **看不见没有声明过的应用**,这个查询**静默返回空列表**,
             于是引擎名回落成 null,构造函数的回调直接给
             `status = TextToSpeech.ERROR(-1)`。

             真机原始证据(model.log,装完这一版当天):
                 18:50:18 房间:TTS 起不来(status=-1 语言=-99)—— 她不发声
             而这台机器**明明有一个引擎**:
                 com.oplus.ttsaccessibilityengine  /product/app/...  enabled=true

             症状的坏处在于它长得完全不像 bug:字幕正常弹、嘴型正常动、
             开关显示「开」,就是一声不吭,而且一行报错都没有。

             声明的是「能当 TTS 引擎的服务」这个**类别**,不是一份包名白名单 ——
             换任何一台机器、任何一个引擎都适用。 -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <!-- ★ 图标换成她那个(2026-10-04)。不只是「换成她的」——
         `ic_conmarn` 有完整的 adaptive icon(前景/背景/圆形,`mipmap-anydpi-v26/ic_conmarn.xml`,
         底色 #E05B8E),而 `ic_launcher` 只有一个绿方块 PNG、**连 adaptive 版本都没有**。
         所以这是纯升级,不是取舍。 -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_conmarn"
        android:roundIcon="@mipmap/ic_conmarn_round"
        android:label="@string/app_name"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Touchpad">

        <!-- 开屏动画,★ 2026-10-04 起**暂时停用**:
             原来点桌面图标先进这里,播 4.5 秒(「RuoXi」→「XChan OS」)再进 MainActivity。
             合并成一个 App 之后有两个问题:
               ① 那两幕大字成了唯一 App 的开场字幕,和「只有一个 App 叫 ConMarn」打架;
               ② 更实际的:她自己的图标原来是**直接进房间、没有开屏**的,
                  入口一旦统一到这里,就变成每次进她都要先等 4.5 秒 —— 那是退步。
             用户说「之后再教你」怎么做开场,所以文件一行不删,SplashView 原样留着。
             要恢复:把 intent-filter 加回来 + `exported` 改回 true。 -->
        <activity
            android:name=".SplashActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.Touchpad.Splash"
            android:launchMode="singleTask" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <!-- 任意应用「分享」文件 -> 选「ConMarn」-> 直接传到电脑中转目录 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- ConMarn:她的房间。聊天/干活一个界面,语音+TTS。不需要麦克风权限
             (录音在系统识别服务里),不需要悬浮窗权限(不是 overlay)。

             ★ 2026-10-04:她是**唯一的门**了(桌面唯一图标 → ConMarnActivity),
               所以加 `launchMode="singleTask"`。
               原来它没有 launchMode(默认 standard),是**全项目唯一一个没有的** ——
               MainActivity 和 SplashActivity 早就是 singleTask(这个坑撞过、修过,漏了她)。
               今天她只能从 MainActivity 的一个按钮进,所以没暴露;变成主入口之后
               还会被开机广播/通知/悬浮球从各处拉起,standard 的后果是:
               **连着点两下桌面图标 → 两个房间、两个 WebView、两个她的身体**同时活着。
               (人格是共享的 —— AiAgentHolder 是进程级单例;但 WebView 和 3D 场景
                是每个 Activity 实例一份,那个是真会看到两个身体。) -->
        <activity
            android:name=".ConMarnActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- 她的桌面图标 —— 2026-10-04 起是**唯一**的桌面入口。
             为什么保留 alias 而不是保留 SplashActivity 那条:
               alias 本来就长对了(名字 ConMarn、图标 ic_conmarn、目标 ConMarnActivity),
               保留它 = 用户桌面上原来那个 ConMarn 图标**原地不动、位置不变**
               (用户确认过平时点的就是它)。删掉的是他没在用的「若息·Terminal Max」那个。
             反过来做(留 SplashActivity 当入口)两个图标会全失效,用户得重摆。
             名字现在直接用 `app_name` —— App 自己就叫 ConMarn 了,不必再单独一条字符串。 -->
        <activity-alias
            android:name=".ConMarnLauncher"
            android:targetActivity=".ConMarnActivity"
            android:exported="true"
            android:icon="@mipmap/ic_conmarn"
            android:roundIcon="@mipmap/ic_conmarn_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="dataSync|camera|microphone" />

        <!-- 「她一直在」的前台服务。**和 KeepAliveService 并存,不动老的** ——
             老的管「电脑连接 + 摄像头/麦克风」,是另一条生命周期。
             ⚠️ 不用 dataSync 的理由见文件顶部那两条权限的注释。 -->
        <service
            android:name=".HerLifeService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <!-- specialUse 必须给一个「干什么用的」理由,系统可能把它显示给用户。 -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="陪伴型助手常驻:在她不被打开时也保持可被唤醒,以便主动提醒与随时响应" />
        </service>

        <!-- 「唤醒词在听」的前台服务 —— **麦克风型**。
             ★★ 它存在的唯一理由:这台机上录音权限是「仅在使用中允许」那一档,
                App 一退后台系统喂给 AudioRecord 的就是**静音**(不报错、读数全零)。
                而唤醒词要听的每一刻正好就是那一刻 —— 没有它,那个开关打开了也不会响。
             权限和类型清单里早就声明过了(FOREGROUND_SERVICE_MICROPHONE),这次一个新权限都没加。
             完整账见 WakeService.kt 的文件头。 -->
        <service
            android:name=".WakeService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- 重启 / 覆盖安装后把她接回来。
             ★ exported="false" 收得到系统广播 —— 非导出接收器的规则是
               「只收系统、同应用、同 UID 发来的」,BOOT_COMPLETED 正是系统发的。
             (MANIFEST 里没有 <queries> 那种问题,这两条广播不需要。) -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 通知上「让她睡」的落点。不导出:只有我们自己的 PendingIntent 能触发它。 -->
        <receiver
            android:name=".HerSleepReceiver"
            android:exported="false" />

        <!-- 通知上「关掉」唤醒的落点。理由同上(见 WakeService.buildNotification)。 -->
        <receiver
            android:name=".WakeOffReceiver"
            android:exported="false" />
    </application>
</manifest>
